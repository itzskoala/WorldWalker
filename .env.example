POSTGRES_USER=worldwalker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=worldwalker

DATABASE_URL=postgresql+psycopg://worldwalker:changeme@localhost:5432/worldwalker
TEST_DATABASE_URL=postgresql+psycopg://worldwalker:changeme@localhost:5432/worldwalker_test

# Generate your own: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Must match the "secret" configured on the Google Health subscriber -
# see auth/register_webhook_subscription.py.
WEBHOOK_SECRET=Bearer changeme

# Your real deployment's public URL (e.g. https://worldwalker.example.com) -
# NOT a tunnel URL. Used only by auth/register_webhook_subscription.py to
# register where Google should push webhook notifications; leave unset
# for local dev and pass a tunnel's https URL as that script's first CLI
# argument instead (see dev_testing/CONNECT.md).
WEBHOOK_PUBLIC_URL=
# The Health Connect Partner API's subscribers/subscriptions endpoints
# require your GCP project NUMBER here (e.g. 580356155767 - Cloud
# Console's top bar, or `gcloud projects describe <project-id>`), NOT the
# project ID string (e.g. coral-core-506316-d1, from service-account.json's
# own "project_id" field - passing that instead 403s as PERMISSION_DENIED
# even with correct IAM roles, since Google resolves it as a different
# identifier entirely).
GCP_PROJECT_ID=

# Generate your own: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh-token cookie's Secure flag. Leave unset (defaults to true) on any
# real deployment (https) - only set to false for local http development.
COOKIE_SECURE=true

# Google OAuth client - only needed on a real deployment. Local dev keeps
# using credentials.json (gitignored) instead; a git-linked deployment
# never sees that file, so these three take over there. Values come from
# the same OAuth client as credentials.json ("web" section); the redirect
# URI must also be registered on that client in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-deployment.example.com/auth/google/callback

# "Sign in with Google" (accounts/google_oauth.py) - a separate OAuth 2.0
# Client ID from GOOGLE_OAUTH_CLIENT_ID above. That one is a data-access
# grant (Google Health scopes, authorization code + refresh tokens); this
# one only ever verifies a short-lived identity token (no secret needed -
# it's sent to the browser, see web/templates/signup.html and login.html).
# Create a separate "Web application" OAuth client in Google Cloud Console
# (APIs & Services > Credentials), add this deployment's origin(s) under
# "Authorized JavaScript origins" (e.g. http://localhost:8000 for local
# dev, your real domain for production - no path, no trailing slash), and
# paste its Client ID here. Leave unset to hide the Google button
# entirely (app.py's _google_signin_client_id()) - email sign-in/sign-up
# still works.
GOOGLE_SIGNIN_CLIENT_ID=

# Sign in with Apple JS (frontend/src/components/AppleSignInButton.tsx) -
# the Services ID from an Apple Developer account (Certificates,
# Identifiers & Profiles > Identifiers > Services IDs), configured with
# this deployment's domain and redirect URI. No backend callback exists
# for it yet (see app.py's _apple_signin_client_id()) - leave unset to
# show the button in its real, un-clickable style rather than a fake one.
APPLE_SIGNIN_CLIENT_ID=

# Resend (accounts/otp_email.py) - sends the 6-digit code POST
# /auth/signup/start emails out. Requires a domain you own, verified with
# Resend (DNS records added at your registrar) - RESEND_FROM_EMAIL must
# be an address at that domain (e.g. noreply@mail.your-domain.com).
# Leave both unset for local dev: the code is printed to the server
# console instead of emailed, so the signup flow still works end to end.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# How long a signup verification code stays valid (accounts/service.py's
# start_email_signup()/verify_email_signup()).
OTP_EXPIRE_MINUTES=10

# Ollama Cloud - powers checkpoint description text (travel_logic/
# description_generator.py). NOT an OpenAI key - create one at
# https://ollama.com/settings/keys. Missing/invalid degrades gracefully
# to plain fallback text (see travel_logic/checkpoints.py's
# generate_description()), so this is optional for local dev.
OLLAMA_API_KEY=
